APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Makassar
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=pusher
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap1
PUSHER_SCHEME=https

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ---------------------------------------------------------------------------
# Biaya Pendaftaran & Pembayaran (AIIF)
# ---------------------------------------------------------------------------
# Aktifkan/matikan fitur biaya pendaftaran
FESTIVAL_FEE_ENABLED=true
# Nominal biaya (Rupiah). Default Rp10.000.
FESTIVAL_FEE_AMOUNT=10000
# Mode hitung: per_anak (default) atau per_lomba
FESTIVAL_FEE_MODE=per_anak

# Rekening tujuan transfer (diisi panitia)
FESTIVAL_BANK_NAME=
FESTIVAL_BANK_NUMBER=
FESTIVAL_BANK_HOLDER=

# Batas ukuran bukti bayar (KB). Default 3072 (~3 MB).
FESTIVAL_PROOF_MAX_KB=3072

# Aturan bisnis
FESTIVAL_MAX_LOMBA_PER_ANAK=2
FESTIVAL_COUPON_PER_CHILD=1

# Notifikasi email saat status pembayaran berubah (opsional)
FESTIVAL_PAYMENT_NOTIFY=false
